{
  "name": "pokedex",
  "version": "1.0.0",
  "description": "Camera Pokédex: identifies Pokémon via reverse image search and reads out their Bulbapedia entry.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "update-names": "node scripts/fetch-pokemon-names.mjs"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "express": "^4.21.2"
  }
}
